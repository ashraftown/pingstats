<Window x:Class="PingStats.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PingStats"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Width="340"
        Deactivated="OnDeactivated"
        Loaded="OnLoaded"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="720">
  <Window.Resources>
    <Style TargetType="Button" x:Key="ActionButton">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F5F6F7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox" x:Key="ThemedComboBoxStyle">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                            IsHitTestVisible="True"
                            SnapsToDevicePixels="True">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="10,0,0,0"
                            SnapsToDevicePixels="True">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center"
                                          Margin="0,2,0,2"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="Arrow"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="3">
                  <ScrollViewer>
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="FooterButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#B8BABF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="12,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="ToggleButtonStyle">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0,11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="PopupBorder"
          CornerRadius="16"
          BorderThickness="1"
          Padding="20">
    <Border.Effect>
      <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="20" ShadowDepth="4"/>
    </Border.Effect>

    <StackPanel>
      <!-- Header -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="HeaderDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleText" Text="PingStats" FontSize="14" FontWeight="Medium"
                     VerticalAlignment="Center" MouseDown="OnWindowMouseDown"/>
        </StackPanel>
        <Button Grid.Column="2"
                x:Name="PinButton"
                Width="26"
                Height="26"
                Style="{StaticResource ActionButton}"
                Click="OnPinToggle"
                ToolTip="Pin &#x2014; keep open when clicking outside">
          <Viewbox Width="14" Height="14">
            <Viewbox.RenderTransform>
              <RotateTransform x:Name="PinIconRotate" Angle="35"/>
            </Viewbox.RenderTransform>
            <Canvas Width="24" Height="24">
              <Path x:Name="PinIcon"
                    Data="M12,2 C10.9,2 10,2.9 10,4 L10,9 L6,18 L18,18 L14,9 L14,4 C14,2.9 13.1,2 12,2 Z"
                    Fill="Transparent"
                    StrokeThickness="1.5"
                    StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </Button>
      </Grid>

      <!-- Hero -->
      <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock x:Name="HeroNumber" FontFamily="Consolas" FontSize="38" FontWeight="Medium"/>
          <TextBlock x:Name="HeroUnit" Text="ms" FontFamily="Consolas" FontSize="16"
                     VerticalAlignment="Bottom" Margin="2,0,0,3"/>
        </StackPanel>
        <TextBlock x:Name="HeroCaption" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>

      <!-- Chart -->
      <Grid Height="64" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <TextBlock x:Name="AxisTopLabel" HorizontalAlignment="Right" VerticalAlignment="Top"
                     FontFamily="Consolas" FontSize="8.5" Margin="0,0,6,0"/>
          <TextBlock x:Name="AxisMidLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontFamily="Consolas" FontSize="8.5" Margin="0,0,6,0"/>
          <TextBlock x:Name="AxisBottomLabel" Text="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     FontFamily="Consolas" FontSize="8.5" Margin="0,0,6,0"/>
        </Grid>
        <Grid Grid.Column="1" ClipToBounds="True">
          <Line x:Name="GridTop" X1="0" Y1="0.037" X2="1" Y2="0.037" Stretch="Fill"
                StrokeDashArray="2 3" StrokeThickness="1"/>
          <Line x:Name="GridMid" X1="0" Y1="0.472" X2="1" Y2="0.472" Stretch="Fill"
                StrokeDashArray="2 3" StrokeThickness="1"/>
          <Line x:Name="GridBottom" X1="0" Y1="0.907" X2="1" Y2="0.907" Stretch="Fill"
                StrokeThickness="1"/>
          <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="OnGraphSizeChanged">
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="ChartSlide"/>
            </Canvas.RenderTransform>
          </Canvas>
        </Grid>
      </Grid>

      <!-- Stats -->
      <Grid Margin="0,0,0,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1"/>
        </Grid.RowDefinitions>
        <Rectangle x:Name="StatsTopBorder" Grid.Row="0" Height="1" Fill="#22FFFFFF"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,8,0,8">
            <TextBlock x:Name="StatMinText" FontFamily="Consolas" FontSize="15" FontWeight="Medium"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatMinLabel" Text="min" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
          </StackPanel>
          <Rectangle Grid.Column="1" x:Name="StatDivider1" Width="1" Fill="#15FFFFFF"/>
          <StackPanel Grid.Column="2" Margin="0,8,0,8">
            <TextBlock x:Name="StatAvgText" FontFamily="Consolas" FontSize="15" FontWeight="Medium"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatAvgLabel" Text="avg" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
          </StackPanel>
          <Rectangle Grid.Column="3" x:Name="StatDivider2" Width="1" Fill="#15FFFFFF"/>
          <StackPanel Grid.Column="4" Margin="0,8,0,8">
            <TextBlock x:Name="StatMaxText" FontFamily="Consolas" FontSize="15" FontWeight="Medium"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatMaxLabel" Text="max" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
        <Rectangle x:Name="StatsBottomBorder" Grid.Row="2" Height="1" Fill="#22FFFFFF"/>
      </Grid>

      <!-- Status -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="status" FontSize="12" VerticalAlignment="Center"/>
        <Border Grid.Column="1" x:Name="StatusPill" CornerRadius="20" Padding="9,3" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="5" Height="5" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" FontSize="11" FontWeight="Medium" Margin="5,0,0,0"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Host -->
      <StackPanel Margin="0,0,0,12">
        <TextBlock x:Name="HostLabel" Text="host" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="HostTextBox" FontFamily="Consolas" FontSize="13"
                 Padding="10,8" BorderThickness="1" KeyDown="OnHostKeyDown"/>
        <TextBlock x:Name="ResolveNote" FontSize="10" Margin="0,5,0,0" MinHeight="15"/>
      </StackPanel>

      <!-- Interval -->
      <StackPanel Margin="0,0,0,14">
        <TextBlock x:Name="IntervalLabel" Text="check every" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox x:Name="IntervalCombo"
                  Style="{StaticResource ThemedComboBoxStyle}"
                  SelectedIndex="1"
                  HorizontalAlignment="Stretch"
                  FontFamily="Consolas"
                  FontSize="13">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="4,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Toggle -->
      <Button x:Name="ToggleButton"
              Style="{StaticResource ToggleButtonStyle}"
              Click="OnStartStopToggle"
              Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock x:Name="ToggleIcon" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="ToggleLabel" FontSize="13" FontWeight="SemiBold"
                     Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <!-- Footer -->
      <Grid x:Name="FooterRow">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0"
                  x:Name="LoginCheckBox"
                  Content="open at login"
                  FontSize="12"
                  VerticalAlignment="Center"
                  Checked="OnLoginCheckChanged"
                  Unchecked="OnLoginCheckChanged"/>
        <Button Grid.Column="1"
                x:Name="QuitButton"
                Style="{StaticResource FooterButton}"
                Click="OnQuit">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       VerticalAlignment="Center"/>
            <TextBlock Text="quit" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Quit confirm -->
      <Grid x:Name="QuitConfirmRow" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="quit pingstats?" FontSize="12" VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                x:Name="QuitCancelBtn"
                Style="{StaticResource FooterButton}"
                Content="cancel"
                Margin="6,0,0,0"
                Click="OnQuitCancel"/>
        <Button Grid.Column="2"
                x:Name="QuitConfirmBtn"
                Style="{StaticResource FooterButton}"
                Content="quit"
                Margin="6,0,0,0"
                Click="OnQuitConfirm"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>