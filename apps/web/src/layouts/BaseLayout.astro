---
import "../styles/global.css";
import { GITHUB_REPO } from "../consts";
import {
  brandColors,
  siteAppleIcon,
  siteDescription,
  siteFaviconIco,
  siteFaviconPng,
  siteIcon,
  siteLocale,
  siteLogo,
  siteManifest,
  siteName,
  siteShareImage,
  siteTitle,
  siteUrl,
} from "../site";

const absolute = (path: string) => new URL(path, siteUrl).toString();

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: siteName,
  url: siteUrl,
  description: siteDescription,
  applicationCategory: "UtilityApplication",
  operatingSystem: "macOS, Windows",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  logo: { "@type": "ImageObject", url: absolute(siteLogo.path) },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type={siteIcon.type} href={siteIcon.path} />
    <link rel="icon" type={siteFaviconPng.type} sizes="32x32" href={siteFaviconPng.path} />
    <link rel="icon" type={siteFaviconIco.type} sizes={siteFaviconIco.sizes} href={siteFaviconIco.path} />
    <link rel="apple-touch-icon" href={siteAppleIcon.path} sizes="180x180" />
    <link rel="manifest" href={siteManifest.path} />
    <meta name="theme-color" content={brandColors.background} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={siteLocale} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={absolute(siteShareImage.path)} />
    <meta property="og:image:width" content={siteShareImage.width} />
    <meta property="og:image:height" content={siteShareImage.height} />
    <meta property="og:image:alt" content={siteShareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={absolute(siteShareImage.path)} />
    <meta name="twitter:image:alt" content={siteShareImage.alt} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <nav class="nav">
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="PingStats home">
            <img src={siteLogo.path} alt="" class="nav-logo" width="30" height="30" />
            <span class="nav-brand-name">PingStats</span>
          </a>
          <div class="nav-right">
            <a class="nav-stars" href={`${GITHUB_REPO}/stargazers`} target="_blank" rel="noopener noreferrer" aria-label="Star PingStats on GitHub">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.3l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.12l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.3z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src={siteLogo.path} alt="" class="footer-logo" width="18" height="18" />
            <span>&copy; {new Date().getFullYear()} Corewaze · MIT licensed</span>
          </div>
          <div class="footer-links">
            <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={`${GITHUB_REPO}/releases`} target="_blank" rel="noopener noreferrer">Releases</a>
            <a href={`${GITHUB_REPO}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">License</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const nav = document.querySelector(".nav");
      const onScroll = () => { if (nav) nav.classList.toggle("is-scrolled", window.scrollY > 12); };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  .page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .nav.is-scrolled {
    border-bottom-color: var(--border);
  }

  .nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    transition: color 0.2s ease;
  }

  .nav-brand:hover {
    color: #fff;
  }

  .nav-logo {
    border-radius: 4px;
    flex-shrink: 0;
  }

  .nav-brand-name {
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .nav-stars {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    color: var(--fg-muted);
    font-size: 13px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .nav-stars:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-stars svg {
    color: var(--warn);
    flex-shrink: 0;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 40px 0 32px;
  }

  .footer-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--fg-dim);
  }

  .footer-logo {
    border-radius: 4px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--fg-dim);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 820px) {
    .nav-inner,
    .footer-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .footer {
      padding-bottom: max(32px, env(safe-area-inset-bottom));
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 28px;
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 14px 20px;
      justify-content: initial;
    }
  }
</style>
