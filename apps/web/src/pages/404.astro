---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="notfound">
    <p class="notfound-code">404</p>
    <h1 class="notfound-title display">Destination unreachable</h1>
    <p class="notfound-sub">
      The page you're looking for doesn't exist, or the link is broken. PingStats itself is still up.
    </p>
    <a href="/" class="btn btn-primary btn-lg">Back to PingStats</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding: 128px 32px;
    text-align: center;
  }

  .notfound-code {
    font-family: var(--font-mono);
    font-size: 72px;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--fg-dim);
    margin: 0 0 24px;
  }

  .notfound-title {
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 auto 16px;
    max-width: 22ch;
    text-wrap: balance;
  }

  .notfound-sub {
    color: var(--fg-muted);
    font-size: 17px;
    max-width: 480px;
    margin: 0 auto 36px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .notfound {
      padding: 96px 20px;
    }
  }
</style>
