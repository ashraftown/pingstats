---
import { MACOS_DMG, WINDOWS_ZIP } from "../consts";
import { RELEASES_URL } from "../lib/releases";
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-float" aria-hidden="true">
    <span class="hero-float-mark hf-1"><span class="hero-float-chip hf-green">24ms</span></span>
    <span class="hero-float-mark hf-2"><span class="hero-float-chip hf-yellow">87ms</span></span>
    <span class="hero-float-mark hf-3"><span class="hero-float-chip hf-green">12ms</span></span>
    <span class="hero-float-mark hf-4"><span class="hero-float-chip hf-orange">156ms</span></span>
    <span class="hero-float-mark hf-5"><span class="hero-float-chip hf-red">342ms</span></span>
    <span class="hero-float-mark hf-6"><span class="hero-float-chip hf-green">8ms</span></span>
  </div>

  <div class="container hero-inner">
    <p class="hero-badge" data-rise>Free &amp; open source</p>

    <h1 class="hero-title display">
      <span data-rise>Live network latency</span><br /><span data-rise style="--d:90ms">in your menu bar or system tray.</span>
    </h1>

    <p class="hero-sub" data-rise style="--d:300ms">
      A lightweight desktop utility that continuously pings any host and displays
      real-time round-trip time — right where you can see it.
    </p>

    <div class="hero-actions" data-rise style="--d:400ms">
      <a id="dl-mac" href={MACOS_DMG} class="btn btn-primary btn-lg hero-btn">
        <svg width="18" height="18" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
        Download for macOS
      </a>
      <a id="dl-win" href={WINDOWS_ZIP} class="btn btn-ghost btn-lg hero-btn">
        <svg width="18" height="18" viewBox="0 0 88 88" fill="currentColor" aria-hidden="true"><path d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
        Download for Windows
      </a>
      <p class="hero-version">
        <a id="version-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">Changelog</a>
      </p>
    </div>

    <!-- The rise wrapper is separate so its animated transform does not override the preview tilt. -->
    <div data-rise style="--d:520ms">
      <div class="hero-preview">
        <figure class="hero-screenshot-frame">
          <img src="/pingstats-popup-ui.png" alt="PingStats popup UI showing live stats and bar graph" width="606" height="340" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  import { fetchLatestRelease, fallbackUrl, pickAsset } from "../lib/releases";
  import { startHomeMotion } from "../lib/homeMotion";

  // Swap the /latest/download redirects for exact versioned asset URLs so a
  // click starts the file immediately instead of bouncing through GitHub.
  // Also stamps the version line with the live tag.
  async function rewireDownloads() {
    const mac = document.getElementById("dl-mac") as HTMLAnchorElement | null;
    const win = document.getElementById("dl-win") as HTMLAnchorElement | null;
    const versionLink = document.getElementById("version-link") as HTMLAnchorElement | null;
    if (!mac && !win) return;
    try {
      const release = await fetchLatestRelease();
      if (mac) mac.href = pickAsset(release.assets ?? [], "mac") ?? fallbackUrl("mac");
      if (win) win.href = pickAsset(release.assets ?? [], "win") ?? fallbackUrl("win");
      if (versionLink && release.tag_name) {
        versionLink.textContent = release.tag_name;
        if (release.html_url) versionLink.href = release.html_url;
      }
    } catch {
      // Offline or API limit: keep the static latest/download fallbacks.
    }
  }

  rewireDownloads();

  const hero = document.querySelector<HTMLElement>(".hero");
  const field = document.querySelector<HTMLElement>(".hero-float");
  if (hero && field) {
    startHomeMotion({ hero, field });
  }
</script>

<style>
  .hero {
    padding: 72px 0 60px;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    padding: 6px 14px;
    margin: 0 auto 20px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }

  .hero-title {
    font-size: clamp(38px, 5.6vw, 76px);
    margin: 48px auto 22px;
    max-width: 20ch;
    text-wrap: balance;
  }
  /* Inline boxes ignore transforms, so each rising line needs its own block. */
  .hero-title span { display: inline-block; }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 640px;
    margin: 0 auto 36px;
    letter-spacing: -0.005em;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
  }

  .hero-version {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-dim);
    font-size: 13px;
    letter-spacing: -0.005em;
  }

  .hero-version a {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
    transition: color 0.18s ease, text-decoration-color 0.18s ease;
  }

  .hero-version a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* Marks enter once, then drift while visible and lean toward the pointer. */
  .hero-float {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    --px: 0px;
    --py: 0px;
  }

  .hero-float-mark {
    position: absolute;
    left: calc(50% + var(--x));
    top: var(--y);
    translate: calc(-50% + var(--px) * var(--depth)) calc(var(--py) * var(--depth));
    transition: translate var(--parallax-duration, 0s) cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero-float-chip {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
    white-space: nowrap;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.5);
    animation:
      mark-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d) both,
      mark-drift var(--dur) ease-in-out calc(var(--d) + 1s) infinite;
    animation-play-state: running, var(--home-motion-state, paused);
  }

  @keyframes mark-in {
    from { opacity: 0; transform: translate(var(--fx), var(--fy)) rotate(calc(var(--rot) + 24deg)) scale(0.6); }
    to { opacity: 1; transform: translate(0, 0) rotate(var(--rot)) scale(1); }
  }
  @keyframes mark-drift {
    0%, 100% { transform: translate(0, 0) rotate(var(--rot)); }
    50% { transform: translate(var(--dx), var(--dy)) rotate(calc(var(--rot) + var(--wob))); }
  }

  .hf-green {
    color: var(--ok);
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.2);
  }

  .hf-yellow {
    color: var(--warn);
    background: rgba(234, 179, 8, 0.1);
    border-color: rgba(234, 179, 8, 0.2);
  }

  .hf-orange {
    color: var(--orange);
    background: rgba(249, 115, 22, 0.1);
    border-color: rgba(249, 115, 22, 0.2);
  }

  .hf-red {
    color: var(--red);
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .hf-1 { --x: max(-300px, -19vw); --y: 20px; --rot: 6deg; --depth: 0.6; --d: 620ms; --dur: 8.5s; --dx: 2px; --dy: -8px; --wob: 3deg; --fx: -40px; --fy: -80px; }
  .hf-2 { --x: min(300px, 19vw); --y: 20px; --rot: -5deg; --depth: 0.6; --d: 580ms; --dur: 9.8s; --dx: -2px; --dy: -9px; --wob: -3deg; --fx: 40px; --fy: -80px; }
  .hf-3 { --x: max(-560px, -38vw); --y: 128px; --rot: -8deg; --depth: 1.2; --d: 380ms; --dur: 10.5s; --dx: 4px; --dy: -12px; --wob: -2deg; --fx: -160px; --fy: -40px; }
  .hf-4 { --x: min(560px, 38vw); --y: 128px; --rot: 7deg; --depth: 1.2; --d: 460ms; --dur: 9.2s; --dx: -4px; --dy: -10px; --wob: 2deg; --fx: 160px; --fy: -40px; }
  .hf-5 { --x: max(-440px, -30vw); --y: 440px; --rot: 4deg; --depth: 0.9; --d: 540ms; --dur: 11.5s; --dx: 3px; --dy: -9px; --wob: -3deg; --fx: -120px; --fy: 80px; }
  .hf-6 { --x: min(440px, 30vw); --y: 440px; --rot: -5deg; --depth: 0.9; --d: 700ms; --dur: 7.8s; --dx: -3px; --dy: -11px; --wob: 3deg; --fx: 120px; --fy: 80px; }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-chip { animation: none; transform: rotate(var(--rot)); }
    .hero-float-mark { translate: none; transition: none; }
  }

  @media (max-width: 1180px) {
    .hf-5, .hf-6 { --y: 420px; }
  }

  @media (max-width: 820px) {
    .hero {
      padding-top: 132px;
    }

    .hero-title {
      font-size: clamp(40px, 11vw, 56px);
      margin-top: 14px;
    }

    .hero-actions {
      margin-bottom: 96px;
    }

    /* Four above the headline, two beside the CTA. Keeps the copy clear. */
    .hf-1 { --x: -37vw; --y: 44px; --rot: -10deg; }
    .hf-2 { --x: 37vw; --y: 44px; --rot: 8deg; }
    .hf-3 { --x: -12vw; --y: 52px; --rot: -4deg; }
    .hf-4 { --x: 12vw; --y: 52px; --rot: 5deg; }
    .hf-5 { --x: -36vw; --y: 625px; --rot: -6deg; }
    .hf-6 { --x: 36vw; --y: 625px; --rot: 7deg; }
  }

  @media (max-width: 420px) {
    .hero-float-chip {
      font-size: 11px;
      padding: 4px 10px;
    }
  }

  .hero-preview {
    max-width: 640px;
    margin: 0 auto;
    transform: perspective(2000px) rotateX(2deg);
    transition: transform 0.6s ease;
  }

  .hero-preview:hover {
    transform: perspective(2000px) rotateX(0deg);
  }

  .hero-screenshot-frame {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: #0a0a0c;
    box-shadow: 0 28px 64px -28px rgba(0, 0, 0, 0.75);
    border: 1px solid var(--border);
  }

  .hero-screenshot-frame img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
