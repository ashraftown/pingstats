---
import { MACOS_DMG, WINDOWS_ZIP } from "../consts";
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-float" aria-hidden="true">
    <span class="hero-float-chip hf-green">24ms</span>
    <span class="hero-float-chip hf-yellow">87ms</span>
    <span class="hero-float-chip hf-green">12ms</span>
    <span class="hero-float-chip hf-orange">156ms</span>
    <span class="hero-float-chip hf-red">342ms</span>
    <span class="hero-float-chip hf-green">8ms</span>
  </div>

  <div class="container hero-inner">
    <p class="hero-badge">Free &amp; open source</p>

    <h1 class="hero-title display">
      Live network latency<br />in your menu bar or system tray.
    </h1>

    <p class="hero-sub">
      A lightweight desktop utility that continuously pings any host and displays
      real-time round-trip time — right where you can see it.
    </p>

    <div class="hero-actions">
      <a href={MACOS_DMG} class="btn btn-primary btn-lg hero-btn">
        <svg width="18" height="18" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
        Download for macOS
      </a>
      <a href={WINDOWS_ZIP} class="btn btn-ghost btn-lg hero-btn">
        <svg width="18" height="18" viewBox="0 0 88 88" fill="currentColor" aria-hidden="true"><path d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
        Download for Windows
      </a>
    </div>

    <div class="hero-preview">
      <figure class="hero-screenshot-frame">
        <img src="/pingstats-popup-ui.png" alt="PingStats popup UI showing live stats and bar graph" width="606" height="340" loading="eager" fetchpriority="high" decoding="async" />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 48px 0 40px;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    padding: 6px 14px;
    margin: 0 auto 20px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }

  .hero-title {
    font-size: clamp(38px, 5.6vw, 72px);
    margin: 0 auto 20px;
    max-width: 18ch;
    text-wrap: balance;
  }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 640px;
    margin: 0 auto 36px;
    letter-spacing: -0.005em;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
  }

  .hero-preview {
    max-width: 640px;
    margin: 0 auto;
    transform: perspective(2000px) rotateX(2deg);
    transition: transform 0.6s ease;
  }

  .hero-preview:hover {
    transform: perspective(2000px) rotateX(0deg);
  }

  .hero-screenshot-frame {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: #0a0a0c;
    box-shadow: 0 28px 64px -28px rgba(0, 0, 0, 0.75);
    border: 1px solid var(--border);
  }

  .hero-screenshot-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-float {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .hero-float-chip {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.5);
    animation: float-drift 7s ease-in-out infinite;
  }

  .hf-green {
    color: var(--ok);
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.2);
  }

  .hf-yellow {
    color: var(--warn);
    background: rgba(234, 179, 8, 0.1);
    border-color: rgba(234, 179, 8, 0.2);
  }

  .hf-orange {
    color: var(--orange);
    background: rgba(249, 115, 22, 0.1);
    border-color: rgba(249, 115, 22, 0.2);
  }

  .hf-red {
    color: var(--red);
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .hero-float-chip:nth-child(1) { top: 12%;  left: 8%;  animation-delay: 0s;    transform: rotate(-4deg); }
  .hero-float-chip:nth-child(2) { top: 10%;  right: 8%; animation-delay: -1.5s; transform: rotate(3deg); }
  .hero-float-chip:nth-child(3) { top: 34%;  left: 5%;  animation-delay: -3s;   transform: rotate(-2deg); }
  .hero-float-chip:nth-child(4) { top: 32%;  right: 5%; animation-delay: -4.5s; transform: rotate(2deg); }
  .hero-float-chip:nth-child(5) { top: 54%;  left: 7%;  animation-delay: -6s;   transform: rotate(-3deg); }
  .hero-float-chip:nth-child(6) { top: 50%;  right: 7%; animation-delay: -2s;   transform: rotate(1deg); }

  @media (max-width: 1100px) {
    .hero-float-chip:nth-child(3) { left: 3%; }
    .hero-float-chip:nth-child(4) { right: 3%; }
  }

  @media (max-width: 1000px) {
    .hero-float-chip:nth-child(3) { top: 20%; }
    .hero-float-chip:nth-child(4) { top: 18%; }
    .hero-float-chip:nth-child(5) { display: none; }
    .hero-float-chip:nth-child(6) { display: none; }
  }

  @media (max-width: 820px) {
    .hero {
      padding-top: 100px;
    }

    .hero-title {
      font-size: clamp(36px, 10vw, 48px);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      margin-bottom: 40px;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-float-chip:nth-child(1) { top: 6%;  left: 4%; }
    .hero-float-chip:nth-child(2) { top: 4%;  right: 4%; }
    .hero-float-chip:nth-child(3) { top: 28%; left: 2%; }
    .hero-float-chip:nth-child(4) { top: 26%; right: 2%; }
    .hero-float-chip:nth-child(5) { display: none; }
    .hero-float-chip:nth-child(6) { display: none; }
  }

  @media (max-width: 420px) {
    .hero-float-chip {
      font-size: 11px;
      padding: 4px 10px;
    }
  }
</style>
