---
import { MACOS_DMG, WINDOWS_ZIP } from "../consts";
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-float" aria-hidden="true">
    <span class="hero-float-chip hf-green hf-1">24ms</span>
    <span class="hero-float-chip hf-yellow hf-2">87ms</span>
    <span class="hero-float-chip hf-green hf-3">12ms</span>
    <span class="hero-float-chip hf-orange hf-4">156ms</span>
    <span class="hero-float-chip hf-red hf-5">342ms</span>
    <span class="hero-float-chip hf-green hf-6">8ms</span>
  </div>

  <div class="container hero-inner">
    <p class="hero-badge" data-rise>Free &amp; open source</p>

    <h1 class="hero-title display" data-rise style="--d:90ms">
      Live network latency<br />in your menu bar or system tray.
    </h1>

    <p class="hero-sub" data-rise style="--d:180ms">
      A lightweight desktop utility that continuously pings any host and displays
      real-time round-trip time — right where you can see it.
    </p>

    <div class="hero-actions" data-rise style="--d:270ms">
      <a id="dl-mac" href={MACOS_DMG} class="btn btn-primary btn-lg hero-btn">
        <svg width="18" height="18" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
        Download for macOS
      </a>
      <a id="dl-win" href={WINDOWS_ZIP} class="btn btn-ghost btn-lg hero-btn">
        <svg width="18" height="18" viewBox="0 0 88 88" fill="currentColor" aria-hidden="true"><path d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
        Download for Windows
      </a>
    </div>

    <!-- The rise wrapper is separate so its animated transform does not override the preview tilt. -->
    <div data-rise style="--d:360ms">
      <div class="hero-preview">
        <figure class="hero-screenshot-frame">
          <img src="/pingstats-popup-ui.png" alt="PingStats popup UI showing live stats and bar graph" width="606" height="340" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  import { fetchLatestRelease, fallbackUrl, pickAsset } from "../lib/releases";
  import { startHomeMotion } from "../lib/homeMotion";

  // Swap the /latest/download redirects for exact versioned asset URLs so a
  // click starts the file immediately instead of bouncing through GitHub.
  async function rewireDownloads() {
    const mac = document.getElementById("dl-mac") as HTMLAnchorElement | null;
    const win = document.getElementById("dl-win") as HTMLAnchorElement | null;
    if (!mac && !win) return;
    try {
      const release = await fetchLatestRelease();
      if (mac) mac.href = pickAsset(release.assets ?? [], "mac") ?? fallbackUrl("mac");
      if (win) win.href = pickAsset(release.assets ?? [], "win") ?? fallbackUrl("win");
    } catch {
      // Offline or API limit: keep the static latest/download fallbacks.
    }
  }

  rewireDownloads();

  const hero = document.querySelector<HTMLElement>(".hero");
  const field = document.querySelector<HTMLElement>(".hero-float");
  if (hero && field) {
    startHomeMotion({ hero, field });
  }
</script>

<style>
  .hero {
    padding: 48px 0 40px;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    padding: 6px 14px;
    margin: 0 auto 20px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }

  .hero-title {
    font-size: clamp(38px, 5.6vw, 72px);
    margin: 0 auto 20px;
    max-width: 18ch;
    text-wrap: balance;
  }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 640px;
    margin: 0 auto 36px;
    letter-spacing: -0.005em;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
  }

  .hero-preview {
    max-width: 640px;
    margin: 0 auto;
    transform: perspective(2000px) rotateX(2deg);
    transition: transform 0.6s ease;
  }

  .hero-preview:hover {
    transform: perspective(2000px) rotateX(0deg);
  }

  .hero-screenshot-frame {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: #0a0a0c;
    box-shadow: 0 28px 64px -28px rgba(0, 0, 0, 0.75);
    border: 1px solid var(--border);
  }

  .hero-screenshot-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Floating latency chips. Positions are offsets from the hero center so the
     spread adapts to viewport width; each chip leans toward the pointer
     (via --px/--py) and drifts on its own loop while visible. */
  .hero-float {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    --px: 0px;
    --py: 0px;
  }

  .hero-float-chip {
    position: absolute;
    left: calc(50% + var(--x));
    top: var(--y);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
    translate: calc(var(--px) * var(--depth)) calc(var(--py) * var(--depth));
    transition: translate var(--parallax-duration, 0s) cubic-bezier(0.2, 0.7, 0.2, 1);
    animation:
      chip-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d) both,
      chip-drift var(--dur) ease-in-out calc(var(--d) + 0.9s) infinite;
    animation-play-state: running, var(--home-motion-state, paused);
  }

  @keyframes chip-in {
    from { opacity: 0; transform: translate(var(--fx), var(--fy)) rotate(calc(var(--rot) + 12deg)) scale(0.7); }
    to { opacity: 1; transform: translate(0, 0) rotate(var(--rot)) scale(1); }
  }
  @keyframes chip-drift {
    0%, 100% { transform: translate(0, 0) rotate(var(--rot)); }
    50% { transform: translate(var(--dx), var(--dy)) rotate(calc(var(--rot) + var(--wob))); }
  }

  .hf-green {
    color: var(--ok);
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.2);
  }

  .hf-yellow {
    color: var(--warn);
    background: rgba(234, 179, 8, 0.1);
    border-color: rgba(234, 179, 8, 0.2);
  }

  .hf-orange {
    color: var(--orange);
    background: rgba(249, 115, 22, 0.1);
    border-color: rgba(249, 115, 22, 0.2);
  }

  .hf-red {
    color: var(--red);
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .hf-1 { --x: max(-480px, -34vw); --y: 110px; --rot: -4deg; --depth: 1.1; --d: 420ms; --dur: 7s; --dx: 3px; --dy: -9px; --wob: 2deg; --fx: -60px; --fy: -60px; }
  .hf-2 { --x: min(480px, 34vw); --y: 96px; --rot: 3deg; --depth: 1.1; --d: 500ms; --dur: 8s; --dx: -3px; --dy: -8px; --wob: -2deg; --fx: 60px; --fy: -60px; }
  .hf-3 { --x: max(-560px, -40vw); --y: 265px; --rot: -2deg; --depth: 0.7; --d: 580ms; --dur: 9s; --dx: 2px; --dy: -10px; --wob: -2deg; --fx: -90px; --fy: -20px; }
  .hf-4 { --x: min(560px, 40vw); --y: 250px; --rot: 2deg; --depth: 0.7; --d: 660ms; --dur: 7.6s; --dx: -2px; --dy: -9px; --wob: 2deg; --fx: 90px; --fy: -20px; }
  .hf-5 { --x: max(-420px, -30vw); --y: 430px; --rot: -3deg; --depth: 0.9; --d: 740ms; --dur: 8.6s; --dx: 3px; --dy: -8px; --wob: -2deg; --fx: -70px; --fy: 60px; }
  .hf-6 { --x: min(420px, 30vw); --y: 420px; --rot: 2deg; --depth: 0.9; --d: 820ms; --dur: 7.2s; --dx: -3px; --dy: -10px; --wob: 2deg; --fx: 70px; --fy: 60px; }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-chip { animation: none; transform: rotate(var(--rot)); }
    .hero-float-chip { translate: none; transition: none; }
  }

  @media (max-width: 1180px) {
    .hf-3 { --x: max(-460px, -36vw); }
    .hf-4 { --x: min(460px, 36vw); }
  }

  @media (max-width: 1000px) {
    .hf-5 { display: none; }
    .hf-6 { display: none; }
  }

  @media (max-width: 820px) {
    .hero {
      padding-top: 100px;
    }

    .hero-title {
      font-size: clamp(36px, 10vw, 48px);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      margin-bottom: 40px;
    }

    .hero-actions .btn {
      width: 100%;
    }

    /* Four chips above the headline, spread edge to edge like upstream. */
    .hf-1 { --x: -36vw; --y: 48px; --rot: -6deg; }
    .hf-2 { --x: 36vw; --y: 40px; --rot: 5deg; }
    .hf-3 { --x: -12vw; --y: 60px; --rot: -2deg; }
    .hf-4 { --x: 12vw; --y: 60px; --rot: 3deg; }
    .hf-5 { display: none; }
    .hf-6 { display: none; }
  }

  @media (max-width: 420px) {
    .hero-float-chip {
      font-size: 11px;
      padding: 4px 10px;
    }
  }
</style>
