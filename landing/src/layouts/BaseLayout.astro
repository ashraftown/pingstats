---
import "../styles/global.css";

const GITHUB_REPO = "https://github.com/ashraftown/pingstats";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Live network latency in your menu bar or system tray. PingStats is a lightweight desktop utility that shows real-time ping to any host." />
    <meta property="og:title" content="PingStats" />
    <meta property="og:description" content="Live network latency in your menu bar." />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/pingstats-logo.svg" />
    <title>PingStats — Live Network Latency in Your Menu Bar</title>
  </head>
  <body>
    <div class="page">
      <nav class="nav">
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="PingStats home">
            <img src="/pingstats-logo.svg" alt="" class="nav-logo" width="24" height="24" />
            <span class="nav-brand-name">PingStats</span>
          </a>
          <div class="nav-right">
            <a class="nav-stars" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer" aria-label="Star PingStats on GitHub">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.3l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.12l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.3z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src="/pingstats-logo.svg" alt="" class="footer-logo" width="18" height="18" />
            <span>&copy; {new Date().getFullYear()} Corewaze · MIT licensed</span>
          </div>
          <div class="footer-links">
            <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={`${GITHUB_REPO}/releases`} target="_blank" rel="noopener noreferrer">Releases</a>
            <a href={`${GITHUB_REPO}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">License</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const nav = document.querySelector(".nav");
      const onScroll = () => {
        if (!nav) return;
        if (window.scrollY > 12) nav.classList.add("is-scrolled");
        else nav.classList.remove("is-scrolled");
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .nav.is-scrolled {
    border-bottom-color: var(--border);
  }

  .nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    transition: color 0.2s ease;
  }

  .nav-brand:hover {
    color: #fff;
  }

  .nav-logo {
    border-radius: 4px;
    flex-shrink: 0;
  }

  .nav-brand-name {
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .nav-stars {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    color: var(--fg-muted);
    font-size: 13px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .nav-stars:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-stars svg {
    color: var(--warn);
    flex-shrink: 0;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 40px 0 32px;
  }

  .footer-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--fg-dim);
  }

  .footer-logo {
    border-radius: 4px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--fg-dim);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 820px) {
    .nav-inner,
    .footer-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .footer {
      padding-bottom: max(32px, env(safe-area-inset-bottom));
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 28px;
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 14px 20px;
      justify-content: initial;
    }
  }
</style>
