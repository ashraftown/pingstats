---
const macOS_DMG = "https://github.com/ashraftown/pingstats/releases/latest/download/PingStats.dmg";
const windows_ZIP = "https://github.com/ashraftown/pingstats/releases/latest/download/PingStats-windows.zip";
const GITHUB_REPO = "https://github.com/ashraftown/pingstats";
---

<section class="section cta">
  <div class="container cta-inner">
    <h2 class="display cta-title">
      Your network deserves<br />a permanent spot.
    </h2>
    <p class="cta-sub">
      PingStats is free, open source, and lives quietly in your menu bar.
      Download it and see your latency at a glance.
    </p>
    <div class="cta-actions">
      <a href={macOS_DMG} class="btn btn-primary btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.2-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.12z"/></svg>
        Download for macOS
      </a>
      <a href={windows_ZIP} class="btn btn-ghost btn-lg">Download for Windows</a>
    </div>
    <p class="cta-links">
      <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={`${GITHUB_REPO}/releases`} target="_blank" rel="noopener noreferrer">All releases</a>
    </p>
  </div>
</section>

<style>
  section {
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .cta {
    text-align: center;
  }

  .cta-title {
    font-size: clamp(34px, 5vw, 64px);
    max-width: 16ch;
    margin: 0 auto 22px;
    text-wrap: balance;
  }

  .cta-sub {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 560px;
    margin: 0 auto 36px;
    letter-spacing: -0.005em;
    line-height: 1.55;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .cta-links {
    font-size: 14px;
    color: var(--fg-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .cta-links a {
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }

  .cta-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 820px) {
    section {
      padding: 64px 0;
    }

    .cta-actions {
      flex-direction: column;
    }
  }
</style>
