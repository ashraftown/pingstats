---
const macOS_DMG =
  "https://github.com/ashraftown/pingstats/releases/latest/download/PingStats.dmg";
const windows_ZIP =
  "https://github.com/ashraftown/pingstats/releases/latest/download/PingStats-windows.zip";
const GITHUB_REPO = "https://github.com/ashraftown/pingstats";
---

<header class="hero">
  <div class="hero-content container">
    <img src="/pingstats-logo.svg" alt="PingStats" class="hero-logo" width="80" height="80" />
    <h1 class="hero-title">PingStats</h1>
    <p class="hero-tagline">
      Live network latency in your menu bar or system tray.
    </p>
    <p class="hero-description">
      A lightweight desktop utility that continuously pings any host and displays
      real-time round-trip time — right where you can see it.
    </p>
    <div class="hero-buttons">
      <a href={macOS_DMG} class="btn btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.2-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.12z"/></svg>
        Download for macOS
      </a>
      <a href={windows_ZIP} class="btn btn-secondary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h7v7H3zm0 10h7v7H3zM14 3h7v7h-7zm0 10h7v7h-7z"/></svg>
        Download for Windows
      </a>
    </div>
    <p class="hero-version">
      v1.0 &middot;
      <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
  </div>
</header>

<style>
  .hero {
    padding: 100px 0 60px;
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-logo {
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    background: linear-gradient(135deg, #e8e8ed, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: 1.4rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 580px;
    margin-bottom: 36px;
    line-height: 1.7;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 24px;
  }

  .hero-version {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .hero-version a {
    color: var(--accent);
    text-decoration: none;
  }

  .hero-version a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 60px 0 40px;
    }
    .hero-title {
      font-size: 2.4rem;
    }
    .hero-tagline {
      font-size: 1.15rem;
    }
    .hero-buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
