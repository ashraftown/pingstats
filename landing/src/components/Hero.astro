---
const macOS_DMG = "https://github.com/ashraftown/pingstats/releases/latest/download/PingStats.dmg";
const windows_ZIP = "https://github.com/ashraftown/pingstats/releases/latest/download/PingStats-windows.zip";
const GITHUB_REPO = "https://github.com/ashraftown/pingstats";
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-float" aria-hidden="true">
    <span class="hero-float-chip hf-green">24ms</span>
    <span class="hero-float-chip hf-yellow">87ms</span>
    <span class="hero-float-chip hf-green">12ms</span>
    <span class="hero-float-chip hf-orange">156ms</span>
    <span class="hero-float-chip hf-red">342ms</span>
    <span class="hero-float-chip hf-green">8ms</span>
  </div>

  <div class="container hero-inner">
    <img src="/pingstats-logo.svg" alt="" class="hero-logo" width="64" height="64" />

    <h1 class="hero-title display">
      Live network latency<br />in your menu bar.
    </h1>

    <p class="hero-sub">
      A lightweight desktop utility that continuously pings any host and displays
      real-time round-trip time — right where you can see it.
    </p>

    <div class="hero-actions">
      <a href={macOS_DMG} class="btn btn-primary btn-lg hero-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.2-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.12z"/></svg>
        Download for macOS
      </a>
      <a href={windows_ZIP} class="btn btn-ghost btn-lg hero-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h7v7H3zm0 10h7v7H3zM14 3h7v7h-7zm0 10h7v7h-7z"/></svg>
        Download for Windows
      </a>
    </div>

    <p class="hero-version">
      v1.0 &middot; free &amp; open source &middot;
      <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">MIT licensed</a>
    </p>

    <div class="hero-preview">
      <figure class="hero-screenshot-frame">
        <img src="/pingstats-popup-ui.png" alt="PingStats popup UI showing live stats and bar graph" width="606" height="340" loading="eager" decoding="async" />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 48px 0 40px;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
  }

  .hero-logo {
    margin: 0 auto 24px;
  }

  .hero-title {
    font-size: clamp(38px, 5.6vw, 72px);
    margin: 0 auto 20px;
    max-width: 18ch;
    text-wrap: balance;
  }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 640px;
    margin: 0 auto 36px;
    letter-spacing: -0.005em;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .hero-version {
    font-size: 14px;
    color: var(--fg-dim);
    margin-bottom: 48px;
  }

  .hero-version a {
    color: var(--accent);
    transition: color 0.18s ease;
  }

  .hero-version a:hover {
    color: var(--accent-hover);
  }

  .hero-preview {
    max-width: 780px;
    margin: 0 auto;
    transform: perspective(2000px) rotateX(2deg);
    transition: transform 0.6s ease;
  }

  .hero-preview:hover {
    transform: perspective(2000px) rotateX(0deg);
  }

  .hero-screenshot-frame {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: #0a0a0c;
    box-shadow: 0 28px 64px -28px rgba(0, 0, 0, 0.75);
    border: 1px solid var(--border);
  }

  .hero-screenshot-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-float {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .hero-float-chip {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.5);
    animation: floatDrift 7s ease-in-out infinite;
  }

  .hf-green {
    color: var(--ok);
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.2);
  }

  .hf-yellow {
    color: var(--warn);
    background: rgba(234, 179, 8, 0.1);
    border-color: rgba(234, 179, 8, 0.2);
  }

  .hf-orange {
    color: var(--orange);
    background: rgba(249, 115, 22, 0.1);
    border-color: rgba(249, 115, 22, 0.2);
  }

  .hf-red {
    color: var(--red);
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .hero-float-chip:nth-child(1) { top: 12%;  left: 8%;  animation-delay: 0s;    transform: rotate(-4deg); }
  .hero-float-chip:nth-child(2) { top: 10%;  right: 8%; animation-delay: -1.5s; transform: rotate(3deg); }
  .hero-float-chip:nth-child(3) { top: 34%;  left: 5%;  animation-delay: -3s;   transform: rotate(-2deg); }
  .hero-float-chip:nth-child(4) { top: 32%;  right: 5%; animation-delay: -4.5s; transform: rotate(2deg); }
  .hero-float-chip:nth-child(5) { top: 54%;  left: 7%;  animation-delay: -6s;   transform: rotate(-3deg); }
  .hero-float-chip:nth-child(6) { top: 50%;  right: 7%; animation-delay: -2s;   transform: rotate(1deg); }

  @media (max-width: 820px) {
    .hero {
      padding-top: 100px;
    }

    .hero-title {
      font-size: clamp(36px, 10vw, 48px);
    }

    .hero-actions {
      flex-direction: column;
      margin-bottom: 16px;
    }

    .hero-float-chip:nth-child(1) { top: 6%;  left: 4%; }
    .hero-float-chip:nth-child(2) { top: 4%;  right: 4%; }
    .hero-float-chip:nth-child(3) { top: 28%; left: 2%; }
    .hero-float-chip:nth-child(4) { top: 26%; right: 2%; }
    .hero-float-chip:nth-child(5) { top: 48%; left: 3%;  display: none; }
    .hero-float-chip:nth-child(6) { top: 44%; right: 3%; display: none; }
  }

  @media (max-width: 420px) {
    .hero-float-chip {
      font-size: 11px;
      padding: 4px 10px;
    }
  }
</style>
