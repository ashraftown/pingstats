---
---

<section class="section screenshots">
  <div class="container">
    <div class="section-head">
      <h2>See it in action</h2>
      <p>Real-time latency stats right from your menu bar or system tray — color-coded, always visible.</p>
    </div>
    <div class="screenshots-grid">
      <figure class="screenshot-card tile">
        <div class="screenshot-img-wrap screenshot-img-wrap--icon">
          <img src="/pingstats-icon.png" alt="PingStats menu bar icon showing live ping" width="76" height="72" loading="lazy" />
        </div>
        <figcaption>Live ping in the menu bar / system tray</figcaption>
      </figure>
      <figure class="screenshot-card tile">
        <div class="screenshot-img-wrap screenshot-img-wrap--popup">
          <img src="/pingstats-popup-ui.png" alt="PingStats popup UI showing detailed stats and bar graph" loading="lazy" />
        </div>
        <figcaption>Detailed stats and live bar graph</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    margin-bottom: 56px;
    max-width: 720px;
  }

  .section-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .screenshots-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: start;
    max-width: 800px;
    margin: 0 auto;
  }

  .screenshot-card {
    text-align: center;
  }

  .screenshot-img-wrap {
    overflow: hidden;
  }

  .screenshot-img-wrap--icon {
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screenshot-img-wrap--icon img {
    display: block;
    image-rendering: auto;
  }

  .screenshot-img-wrap--popup img {
    width: 100%;
    height: auto;
    display: block;
  }

  .screenshot-card figcaption {
    padding: 14px 16px;
    font-size: 14px;
    color: var(--fg-muted);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 600px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
    }

    .screenshot-img-wrap--icon {
      max-width: 160px;
      margin: 0 auto;
    }

    section {
      padding: 64px 0;
    }
  }
</style>
