<section class="section screenshots">
  <div class="container">
    <h2 class="section-title">See it in action</h2>
    <p class="section-subtitle">
      Real-time latency stats right from your menu bar — color-coded, always visible.
    </p>
    <figure class="screenshot-card">
      <img src="/pingstats-popup-ui.png" alt="PingStats popup UI showing live stats and bar graph" loading="lazy" />
      <figcaption>Detailed stats and live bar graph</figcaption>
    </figure>
  </div>
</section>

<style>
  .screenshots {
    background: var(--bg-secondary);
  }

  .screenshot-card {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    max-width: 606px;
    margin: 0 auto;
  }

  .screenshot-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  .screenshot-card figcaption {
    padding: 12px 16px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-align: center;
  }
</style>
