---

<section class="section screenshots">
  <div class="container">
    <h2 class="section-title">See it in action</h2>
    <p class="section-subtitle">
      Real-time latency stats right from your menu bar or system tray — color-coded, always visible.
    </p>
    <div class="screenshots-grid">
      <figure class="screenshot-card screenshot-card--icon">
        <img src="/pingstats-icon.png" alt="PingStats menu bar icon" width="76" height="72" loading="lazy" />
        <figcaption>Live ping in the menu bar / system tray</figcaption>
      </figure>
      <figure class="screenshot-card screenshot-card--popup">
        <img src="/pingstats-popup-ui.png" alt="PingStats popup UI showing live stats and bar graph" loading="lazy" />
        <figcaption>Detailed stats and live bar graph</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .screenshots {
    background: var(--bg-secondary);
  }

  .screenshots-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: start;
    max-width: 800px;
    margin: 0 auto;
  }

  .screenshot-card {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
  }

  .screenshot-card--icon {
    text-align: center;
    padding: 20px;
  }

  .screenshot-card--icon img {
    display: block;
    margin: 0 auto;
    image-rendering: auto;
  }

  .screenshot-card--popup {
    max-width: 606px;
  }

  .screenshot-card--popup img {
    width: 100%;
    height: auto;
    display: block;
  }

  .screenshot-card figcaption {
    padding: 12px 16px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-align: center;
  }

  @media (max-width: 600px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
    }

    .screenshot-card--icon {
      max-width: 160px;
      margin: 0 auto;
    }
  }
</style>
