---
import { GITHUB_REPO } from "../consts";
---

<section class="section open-source">
  <div class="container">
    <div class="open-head section-head">
      <span class="eyebrow">Open source</span>
      <h2>Free, MIT-licensed, and ready to fork.</h2>
    </div>

    <div class="open-grid">
      <div class="tile open-term">
        <div class="open-term-head">
          <span></span><span></span><span></span>
          <span class="open-term-title">~/pingstats</span>
        </div>
        <div class="open-term-body">
          <div><span class="prompt">$</span> git clone {GITHUB_REPO}</div>
          <div class="dim">✓ Cloned into ./pingstats</div>
          <div><span class="prompt">$</span> open PingStats.xcodeproj</div>
          <div class="dim">▲ Xcode project loaded</div>
          <div><span class="prompt">$</span> swift build -c release</div>
          <div class="dim">✓ Build succeeded in 8.4s</div>
          <div class="cursor"><span class="prompt">$</span><span class="caret"></span></div>
        </div>
      </div>

      <div class="tile open-pitch">
        <div class="open-pitch-copy">
          <ul class="open-pitch-list">
            <li>
              <span class="open-pitch-mark"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              <span><strong>Change the UI.</strong> Restyle the popup, bar graph, or icon to match your workflow.</span>
            </li>
            <li>
              <span class="open-pitch-mark"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              <span><strong>Add a feature.</strong> Custom ping intervals, logging, alerts — it's all possible.</span>
            </li>
            <li>
              <span class="open-pitch-mark"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              <span><strong>Ship your own build.</strong> Self-compile, sign, and distribute your own version.</span>
            </li>
          </ul>
        </div>

        <div class="open-pitch-footer">
          <div class="open-pitch-meta">
            <span>MIT licensed</span>
          </div>
          <div class="open-pitch-actions">
            <a class="btn btn-primary" href={`${GITHUB_REPO}/fork`} target="_blank" rel="noopener noreferrer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2.2"/><circle cx="18" cy="5" r="2.2"/><circle cx="12" cy="19" r="2.2"/><path d="M6 7.2v2A3 3 0 009 12.2h6A3 3 0 0018 9.2v-2M12 14v2.8"/></svg>
              Fork on GitHub
            </a>
            <a class="open-source-link" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">
              Browse source
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .open-head {
    text-align: center;
    margin: 0 auto 56px;
  }

  .open-head h2 {
    margin-top: 14px;
  }

  .section-head {
    max-width: 720px;
  }

  .section-head .eyebrow {
    display: block;
  }

  .section-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .open-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 20px;
  }

  .open-term { padding: 0; overflow: hidden; }

  .open-term-head {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 14px; border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .open-term-head span:not(.open-term-title) {
    width: 10px; height: 10px; border-radius: 999px;
    background: #2a2a30; display: block;
  }

  .open-term-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
  }

  .open-term-body {
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.8;
  }

  .open-term-body .prompt {
    color: var(--ok);
    margin-right: 8px;
  }

  .open-term-body .dim {
    color: var(--fg-dim);
  }

  .cursor {
    margin-top: 4px;
    display: flex;
    align-items: center;
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: var(--fg);
    animation: blink 1s step-end infinite;
    margin-left: 4px;
  }

  .open-pitch { padding: 0; }

  .open-pitch-copy {
    padding: 28px;
  }

  .open-pitch-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .open-pitch-list li {
    display: flex;
    gap: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .open-pitch-mark {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--ok);
  }

  .open-pitch-list strong {
    color: var(--fg);
  }

  .open-pitch-footer {
    border-top: 1px solid var(--border);
    padding: 20px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .open-pitch-meta {
    font-size: 13px;
    color: var(--fg-dim);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .open-pitch-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .open-source-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }

  .open-source-link:hover {
    color: var(--fg);
  }

  .open-source-link svg {
    transition: transform 0.18s ease;
  }

  .open-source-link:hover svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 820px) {
    .open-grid {
      grid-template-columns: 1fr;
    }

    section {
      padding: 64px 0;
    }
  }
</style>
